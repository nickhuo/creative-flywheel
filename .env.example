# Console CRUD uses a Console API Key. SDK assignment and events use a Server Secret.
# Create both at https://console.statsig.com/api_keys

STATSIG_CONSOLE_API_KEY=console-replace-me
STATSIG_SERVER_SECRET=secret-replace-me
STATSIG_ENVIRONMENT=development
STATSIG_TARGET_APP=replace-with-target-app-id

# Mobile/web simulators use a Client SDK Key, never the Server Secret above.
# STATSIG_CLIENT_KEY=client-replace-me
