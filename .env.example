# Console CRUD uses a Console API Key. SDK assignment and events use a Server Secret.
# Create both at https://console.statsig.com/api_keys

STATSIG_CONSOLE_API_KEY=console-replace-me
STATSIG_SERVER_SECRET=secret-replace-me
STATSIG_ENVIRONMENT=development

# The observation loop only invokes OpenAI after deterministic eligibility passes.
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-5.6-luna

# Optional path relative to the project root. Defaults to artifacts/state.sqlite.
# SIMULA_AGENT_DB=artifacts/state.sqlite

# Set to 1 when local development should not export Agents SDK traces.
# OPENAI_AGENTS_DISABLE_TRACING=1

# Durable observation Worker (Node + Bun). Defaults target a local Temporal server.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=creative-flywheel
# For Temporal Cloud, set its endpoint/namespace above and an API key below (enables TLS).
# TEMPORAL_API_KEY=
# BUN_EXECUTABLE=/absolute/path/to/bun
